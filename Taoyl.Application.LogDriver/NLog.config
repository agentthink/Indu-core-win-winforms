<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="false"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/internal-nlog.txt"
      throwExceptions="false">

	<!-- 日志根目录：由代码在配置载入前置入 GlobalDiagnosticsContext（${gdc:item=logRoot}）。
	     fileName / maxArchiveDays / maxArchiveFiles 会被 LogTargetConfigurator 按配置覆盖；
	     layout 永不被代码覆盖 ⇒ 本文件的 CsvLayout 列结构是唯一真值源（锁死 .csv 裁定）。
	     列结构按通道（中登裁定 09-26）：仅 Error 含 Exception 列（5 列），其余通道 4 列——
	     只有 Error(ex, msg) 的 API 能携带异常，其余通道该列恒空。 -->
	<variable name="logDirectory" value="${gdc:item=logRoot}" />

	<targets>
		<!-- 🔴 唯一能在 XML 配溢出策略的路径（<targets async="true"> 配不了：无参构造恒 10000/Discard）。
		     链序：AsyncWrapper(本元素) → FileTarget；Block = 队列满阻塞生产者不丢行（K3 优先，认下峰值退化同步）。 -->
		<default-wrapper xsi:type="AsyncWrapper" queueLimit="50000" overflowAction="Block" />

		<!-- Debug 通道（落盘但 UI 暂不显示，B3 裁定） -->
		<target xsi:type="File" name="debugFile"
				fileName="${logDirectory}/Debug/Debug_${date:format=yyyyMMdd}.csv"
				keepFileOpen="true" openFileCacheTimeout="30"
				maxArchiveDays="180" maxArchiveFiles="-1">
			<layout xsi:type="CsvLayout" delimiter="Comma" withHeader="true">
				<column name="Time"      layout="${longdate}" />
				<column name="Level"     layout="${level:uppercase=true}" />
				<column name="ThreadId"  layout="${threadid}" />
				<column name="Message"   layout="${message}" />
			</layout>
		</target>

		<!-- Info 通道 -->
		<target xsi:type="File" name="infoFile"
				fileName="${logDirectory}/Info/Info_${date:format=yyyyMMdd}.csv"
				keepFileOpen="true" openFileCacheTimeout="30"
				maxArchiveDays="180" maxArchiveFiles="-1">
			<layout xsi:type="CsvLayout" delimiter="Comma" withHeader="true">
				<column name="Time"      layout="${longdate}" />
				<column name="Level"     layout="${level:uppercase=true}" />
				<column name="ThreadId"  layout="${threadid}" />
				<column name="Message"   layout="${message}" />
			</layout>
		</target>

		<!-- Warn 通道 -->
		<target xsi:type="File" name="warnFile"
				fileName="${logDirectory}/Warn/Warn_${date:format=yyyyMMdd}.csv"
				keepFileOpen="true" openFileCacheTimeout="30"
				maxArchiveDays="180" maxArchiveFiles="-1">
			<layout xsi:type="CsvLayout" delimiter="Comma" withHeader="true">
				<column name="Time"      layout="${longdate}" />
				<column name="Level"     layout="${level:uppercase=true}" />
				<column name="ThreadId"  layout="${threadid}" />
				<column name="Message"   layout="${message}" />
			</layout>
		</target>

		<!-- Error 通道（唯一携带异常的通道：Exception 列记录 ex.ToString() 完整堆栈） -->
		<target xsi:type="File" name="errorFile"
				fileName="${logDirectory}/Error/Error_${date:format=yyyyMMdd}.csv"
				keepFileOpen="true" openFileCacheTimeout="30"
				maxArchiveDays="180" maxArchiveFiles="-1">
			<layout xsi:type="CsvLayout" delimiter="Comma" withHeader="true">
				<column name="Time"      layout="${longdate}" />
				<column name="Level"     layout="${level:uppercase=true}" />
				<column name="ThreadId"  layout="${threadid}" />
				<column name="Message"   layout="${message}" />
				<column name="Exception" layout="${exception:format=tostring}" />
			</layout>
		</target>

		<!-- MES 通道（记录级别恒 Info，B2 裁定） -->
		<target xsi:type="File" name="mesFile"
				fileName="${logDirectory}/MES/MES_${date:format=yyyyMMdd}.csv"
				keepFileOpen="true" openFileCacheTimeout="30"
				maxArchiveDays="180" maxArchiveFiles="-1">
			<layout xsi:type="CsvLayout" delimiter="Comma" withHeader="true">
				<column name="Time"      layout="${longdate}" />
				<column name="Level"     layout="${level:uppercase=true}" />
				<column name="ThreadId"  layout="${threadid}" />
				<column name="Message"   layout="${message}" />
			</layout>
		</target>

	</targets>

	<rules>
		<!-- 🔴 级别不参与过滤（F5）：全部 minlevel="Trace"——rule 只按 logger 名路由，
		     Level 是 CSV 里的数据字段，不是过滤器；全 rule 不匹配 = 静默丢弃（K3 红线）。 -->
		<logger name="LogDriver.Debug" minlevel="Trace" writeTo="debugFile" final="true" />
		<logger name="LogDriver.Info"  minlevel="Trace" writeTo="infoFile"  final="true" />
		<logger name="LogDriver.Warn"  minlevel="Trace" writeTo="warnFile"  final="true" />
		<logger name="LogDriver.Error" minlevel="Trace" writeTo="errorFile" final="true" />
		<logger name="LogDriver.MES"   minlevel="Trace" writeTo="mesFile"   final="true" />
	</rules>

</nlog>
